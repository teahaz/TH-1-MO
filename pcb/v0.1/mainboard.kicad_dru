(version 1)
(rule "USB_SS_track_clearance"
   (condition "A.NetClass == 'USB_SS' && A.Type == 'Track' && B.NetClass != 'USB_SS'")
   (constraint clearance (min 0.45mm)))

(rule "USB_SS_breakout_relaxed"
   (condition "A.NetClass == 'USB_SS' && A.Type == 'Track' && B.NetClass != 'USB_SS' && B.Type != 'Zone' && (A.insideCourtyard('J5') || A.insideCourtyard('J4') || A.insideCourtyard('J2') || A.insideCourtyard('J7') || A.insideCourtyard('U3') || A.insideCourtyard('U2') || A.insideArea('AllowGND'))")
   (constraint clearance (min 0.15mm)))

(rule "MIPI_track_clearance"
   (condition "A.NetClass == 'MIPI_100R' && A.Type == 'Track' && B.NetClass != 'MIPI_100R'")
   (constraint clearance (min 0.4mm)))

(rule "MIPI_breakout_relaxed"
   (condition "A.NetClass == 'MIPI_100R' && A.Type == 'Track' && B.NetClass != 'MIPI_100R' && (A.intersectsCourtyard('J6') || A.intersectsCourtyard('J7'))")
   (constraint clearance (min 0.2mm)))
