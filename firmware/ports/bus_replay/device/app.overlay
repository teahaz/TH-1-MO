&sram0 {
    reg = <0x20000000 DT_SIZE_K(24)>;
};

/ {
    soc {
        ram_loop: memory@20006000 {
            compatible = "zephyr,memory-region", "mmio-sram";
            reg = <0x20006000 DT_SIZE_K(32)>;
            zephyr,memory-region = "LOOPRAM";
        };

        ram7: memory@2000e000 {
            compatible = "zephyr,memory-region", "mmio-sram";
            reg = <0x2000e000 DT_SIZE_K(8)>;
            zephyr,memory-region = "RAM7";
        };

        ram8: memory@20010000 {
            compatible = "zephyr,memory-region", "mmio-sram";
            reg = <0x20010000 DT_SIZE_K(192)>;
            zephyr,memory-region = "RAM8";
        };
    };
};

&uart1 {
    status = "disabled";
};
