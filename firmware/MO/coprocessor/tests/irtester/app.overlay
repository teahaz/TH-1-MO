/ {
    zephyr,user {
        pwms = <&pwm0 0 PWM_HZ(38000) PWM_POLARITY_NORMAL>;
    };
};

&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-names = "default";
};

&pinctrl {
    pwm0_default: pwm0_default {
        group1 {
            psels = <NRF_PSEL(PWM_OUT0, 0, 23)>;
        };
    };
};
